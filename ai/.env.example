# Copy this file to `.env.local` and fill in your value(s).
#
# The OAuth Client ID from an ArcGIS Online "OAuth credentials" developer item
# (user authentication, PKCE — no client secret). Add these redirect URIs to it:
#   http://localhost:5173      (local dev)
#   https://dchantlos.github.io (later, if embedded in the live app)
VITE_ARCGIS_OAUTH_APP_ID=

# Portal to sign in against. Leave as ArcGIS Online unless you use an org URL
# (e.g. https://<org-key>.maps.arcgis.com to route SAML/enterprise logins).
VITE_PORTAL_URL=https://www.arcgis.com
